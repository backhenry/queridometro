# Copie este arquivo para .env.local e preencha.
# No Supabase: Project Settings → API

# Ex.: https://abcdefghijk.supabase.co
SUPABASE_URL=

# A chave "service_role" (NÃO a anon). Ela é secreta e só é usada no servidor —
# por isso não tem NEXT_PUBLIC_ no nome: assim o Next nunca manda ela pro navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Sem essas duas variáveis, o site grava os votos em .dados/votos.json
# (funciona local, mas não na Vercel).
